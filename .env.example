# LLM configuration (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=your-anthropic-model-id

# PayPal sandbox credentials (must remain sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# App & database
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/agent-allowance.db

# Demo & testing flags
DEMO_MODE=1
MOCK_LLM=0
# Default is "real" when PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are set.
# Set PAYMENT_MODE=simulated explicitly to run without live PayPal sandbox calls.
PAYMENT_MODE=real

# Optional product provider
CHANNEL3_API_KEY=

